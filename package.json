{
  "name": "rapid-ireport-community-safety-system",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && esbuild api/api_handlers/**/*.ts --platform=node --format=cjs --out-extension:.js=.cjs --outbase=api/api_handlers --outdir=dist/api/api_handlers",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@kurkle/color": "0.3.2",
    "@supabase/supabase-js": "2.44.4",
    "@turf/turf": "^7.3.5",
    "date-fns": "^3.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "html5-qrcode": "^2.3.8",
    "leaflet": "1.9.4",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "4.2.1",
    "recharts": "^3.8.1",
    "tesseract.js": "5.1.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2"
  }
}

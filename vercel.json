{
  "version": 2,
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/saps_gauteng.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

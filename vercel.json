{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/update-profile",
      "destination": "/api/profiles"
    },
    {
      "source": "/api/update-setting",
      "destination": "/api/companies"
    },
    {
      "source": "/api/reverse-geocode",
      "destination": "/api/geocode"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
